rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidReview(data) {
      return data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2000;
    }

    // User Profile
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Wishlist Subcollection
      match /wishlist/{wishlistId} {
        allow read, write, delete: if isOwner(userId) && isValidId(wishlistId);
      }

      // Orders Subcollection
      match /orders/{orderId} {
        allow read, write: if isOwner(userId) && isValidId(orderId);
      }
    }

    // Customer Reviews Collection (Public Read, Authenticated Write)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(reviewId) && isValidReview(request.resource.data);
      allow update: if isSignedIn() && isValidId(reviewId) && resource.data.userId == request.auth.uid && isValidReview(request.resource.data);
      allow delete: if isSignedIn() && isValidId(reviewId) && resource.data.userId == request.auth.uid;
    }
  }
}
